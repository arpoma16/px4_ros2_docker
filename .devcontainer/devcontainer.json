{
    "name": "px4-devcontainer-nvidia",
    "image": "ros2-px4-ws:humble",
    "workspaceFolder": "/root/ros2_ws/src/external",
    "workspaceMount": "source=${localWorkspaceFolder},target=/root/ros2_ws/src/external,type=bind",
    "initializeCommand": "xhost +local:docker && mkdir -p /tmp/runtime-root && chmod 0700 /tmp/runtime-root",
    "postCreateCommand": "sh ./.devcontainer/postCreate.sh",
    "shutdownAction": "stopContainer",

    "runArgs": [
        "--name=dev_px4_ros2_cont_nvidia",
        "--runtime=nvidia",
        "--gpus=all",
        "--network=host",
        "--ipc=host",
        "--privileged",
        "--env=DISPLAY=${localEnv:DISPLAY}",
        "--env=XAUTHORITY=${localEnv:XAUTHORITY}",
        "--env=QT_X11_NO_MITSHM=1",
        "--env=NVIDIA_VISIBLE_DEVICES=all",
        "--env=NVIDIA_DRIVER_CAPABILITIES=all",
        "--env=XDG_RUNTIME_DIR=/tmp/runtime-root",
        "--env=__NV_PRIME_RENDER_OFFLOAD=1",
        "--env=__GLX_VENDOR_LIBRARY_NAME=nvidia",
        "--volume=/tmp/.X11-unix:/tmp/.X11-unix:rw",
        "--volume=${localEnv:XAUTHORITY}:${localEnv:XAUTHORITY}",
        "--volume=/etc/machine-id:/etc/machine-id:ro",
        "--device=/dev/dri:/dev/dri"
    ],

    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "XAUTHORITY": "${localEnv:XAUTHORITY}",
        "QT_X11_NO_MITSHM": "1",
        "NVIDIA_VISIBLE_DEVICES": "all",
        "NVIDIA_DRIVER_CAPABILITIES": "all",
        "XDG_RUNTIME_DIR": "/tmp/runtime-root",
        "__NV_PRIME_RENDER_OFFLOAD": "1",
        "__GLX_VENDOR_LIBRARY_NAME": "nvidia"
    },

    "features": {
        "ghcr.io/devcontainers/features/common-utils": {
            "installZsh": true,
            "installOhMyZsh": true,
            "installOhMyZshConfig": true,
            "configureZshAsDefaultShell": true
        },
        "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
            "plugins": "zsh-autosuggestions zsh-syntax-highlighting",
            "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions.git https://github.com/zsh-users/zsh-users/zsh-syntax-highlighting.git"
        }
    },

    "customizations": {
        "vscode": {
            "extensions":[
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-themes",
                "twxs.cmake",
                "donjayamanne.python-extension-pack",
                "eamodio.gitlens",
                "Ranch-Hand-Robotics.rde-pack",
                "redhat.vscode-xml",
                "smilerobotics.urdf",
                "tamasfe.even-better-toml",
                "timonwong.shellcheck",
                "streetsidesoftware.code-spell-checker",
                "yzhang.markdown-all-in-one",
                "GitHub.copilot",
                "anthropic.claude-code"
            ],
            "settings": {
                "editor.tabSize": 4,
                "terminal.integrated.fontFamily": "MesloLGM Nerd Font",
                "terminal.integrated.fontLigatures.enabled": true,
                "terminal.integrated.defaultProfile.linux": "zsh",
                "terminal.integrated.profiles.linux": {
                    "zsh": {
                        "path": "/bin/zsh",
                        "icon": "terminal-ubuntu"
                    }
                },
                "files.associations": {
                    "*.rviz": "yaml",
                    "*.srdf": "xml",
                    "*.urdf": "xml",
                    "model.config": "xml",
                    "*.sdf": "xml",
                    "*.xacro": "xml"
                }
            }
        }
    }
}
